# Private local Mac worker configuration; copy to .env, chmod 600 .env, and fill locally.
# Never put credentials or private watch coordinates in URLs.
EW_API_URL=http://127.0.0.1:8787
# For hosted Sites, explicitly pin your own exact HTTPS origin (no path or trailing slash).
# EW_SITES_ORIGIN=https://your-site.chatgpt.site
# EW_SITES_SERVICE_TOKEN=replace-with-your-own-scoped-site-service-token
# Set EW_API_URL to that same exact origin; the service credential is never sent elsewhere.
EW_WORKER_TOKEN=replace-with-worker-scoped-application-token
EW_WORKER_ID=local-worker
EW_BATCH_SIZE=4
EW_CODEX_BIN=/absolute/path/to/supported/codex
# Optional OpenAI-compatible backend (docs/inference-providers.md). Without
# EW_INFERENCE_CONFIG it detects one local server on loopback ports.
# EW_ANALYSIS_BACKEND=chat
# EW_INFERENCE_CONFIG=/absolute/private/path/inference.json
# EW_LOCAL_MODEL=exact-model-id-when-a-local-server-lists-several
# Provider keys are named by api_key_env in that file, e.g. GROQ_API_KEY.
# Optional: defaults to work/worker in this repository.
# EW_WORKER_STATE=/absolute/private/path/europe-watch-worker

# Collector configuration is separate from model authentication.
# EW_COLLECTOR_TOKEN=replace-with-collector-scoped-application-token
# EW_COUNTRIES=IT,DE,FR,NO
EW_TFL_REGISTERED=false

# Optional private owner preview: npm run open reads owner token from .dev.vars.
# EW_PREVIEW_PORT=4318

# Local Wrangler .dev.vars / Docker backend needs THREE DISTINCT secrets below.
# Keep these in .dev.vars, not in the worker-only .env or .worker.env.
# EUROPE_WATCH_OWNER_TOKEN=generate-a-distinct-random-value
# EUROPE_WATCH_COLLECTOR_TOKEN=generate-a-distinct-random-value
# EUROPE_WATCH_WORKER_TOKEN=generate-a-distinct-random-value

# Optional Docker analysis profile: create .worker.env with EW_API_URL and
# EW_WORKER_TOKEN only (plus nonsecret tuning). Fresh Codex sign-in uses its
# own named volume. Never mount or copy the Mac's Codex authentication store.

# Remote collector remains paused until explicitly resumed by its operator.
EW_COLLECTION_PAUSED=1
