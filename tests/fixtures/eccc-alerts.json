   "properties": {
    "alert_code": "WDW",
    "alert_type": "warning",
    "alert_name_en": "wind warning",
    "alert_name_fr": "avertissement de vent",
    "alert_short_name_en": "Wind",
    "alert_short_name_fr": "Vent",
