   "properties": {
    "alert_code": "RFW",
    "alert_type": "warning",
    "alert_name_en": "rainfall warning",
    "alert_name_fr": "avertissement de pluie",
    "alert_short_name_en": "Rainfall",
    "alert_short_name_fr": "Pluie",
    "publication_datetime": "2026-10-22T13:43:20.615Z",
    "expiration_datetime": "2026-10-23T05:43:20.615Z",
    "validity_datetime": "2026-10-22T13:41:00.000Z",
    "event_end_datetime": "2026-10-23T23:00:00.000Z",
    "alert_text_en": "Very heavy rain is expected.\n\nLocations: Guysborough County, Richmond County, Sydney Metro and Cape Breton County.\n\nTotal rainfall: 50 to 70 mm.\n\nTime span: today until Friday evening.\n\nRemarks: Gusty winds accompanying the rain may cause tree branches to break.\n\nLocal utility outages are possible.\n\nRainfall warnings are issued when significant impacts are expected due to rainfall amounts.\n\nPlease continue to monitor alerts and forecasts issued by Environment Canada. To report severe weather, send an email to NSstorm@ec.gc.ca or post reports on social media using #NSStorm.",
    "alert_text_fr": "De la pluie très forte est prévue.\n\nRégions : le comté de Guysborough, le comté de Richmond, la ville de Sydney et le comté de Cap-Breton.\n\nQuantité totale de pluie : de 50 à 70 mm.\n\nPériode : d'aujourd'hui jusqu'à vendredi soir.\n\nRemarques : les vents soufflant en rafales qui accompagnent la pluie pourraient casser des branches d'arbres.\n\nDes pannes de courant sont possibles par endroits.\n\nUn avertissement de pluie est émis lorsque des impacts importants sont attendus en raison de la quantité de pluie prévue.\n\nVeuillez continuer à surveiller les alertes et les prévisions émises par Environnement Canada. Pour signaler du temps violent, envoyez un courriel à meteoNS@ec.gc.ca ou publiez un message sur les réseaux sociaux en utilisant #NSMeteo.",
    "risk_colour_en": "yellow",
    "risk_colour_fr": "jaune",
