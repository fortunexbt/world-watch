{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "europe-watch",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {"directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true},
  // Placeholder only: provision your own database and replace database_id before deployment.
  "d1_databases": [{"binding":"DB","database_name":"europe-watch","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"deploy/migrations"}],
  "triggers": {"crons":[]},
  "vars": {"STORAGE_PAUSED":"1", "ANALYSIS_MODE":"local-codex", "CONTRACT_VERSION":"ew-1", "PUBLIC_ORIGIN":"http://127.0.0.1:8787"}
}
